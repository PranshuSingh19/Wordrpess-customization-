function my_post_type(){

	register_post_type("Pranshu",

		array(

			'labels'   			=> array(
				'name' 			=> __('Pranshus', 'textdomain'), // __() is a WordPress localization function that returns a translatable string.
				'singular_name'	=> __('Pranshu', 'textdomain'), // 'textdomain' is a placeholder for your theme or plugin's
			),
			'public'			=> true, // If public true then post type show in dashboard
			'has_archive'		=> true,  // When true, WordPress will generate an archive page for this post type (yoursite.com/pranshus/)
			'supports'			=> array ('title', 'author', 'thumbnail', 'editor', 'excerpt', 'comments'),
		));
}
add_action('init', 'my_post_type');
